<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- The provider is created disabled: `required_if_provider` requires the
         eSewa credentials as soon as the provider is switched to Test Mode or
         Enabled. The credentials are filled by the user (or by the demo data
         below when the module is installed with demo data). -->
    <record id="payment_provider_esewa" model="payment.provider">
        <field name="name">eSewa</field>
        <field name="code">esewa</field>
        <field name="state">disabled</field>
        <!-- Note: the provider starts disabled so credentials are required before
             activation.  To pre-enable it for testing, set state to 'test' and
             is_published to True here, or use the demo/demo.xml data which does
             exactly that (only loaded when installing with demo data). -->
        <!-- Links the provider to the esewa_payment module so the Payment
             Providers list shows its install/activation state like the
             official providers (see payment/data/payment_provider_data.xml). -->
        <field name="module_id" ref="base.module_esewa_payment"/>
        <field name="redirect_form_view_id" ref="payment_esewa_redirect_form"/>
        <field name="payment_method_ids"
               eval="[Command.set([
                         ref('payment_method_esewa'),
                     ])]"
        />
    </record>

</odoo>
